# ─────────────────────────────────────────────────────────────────────────────
# Copiá este archivo a `.env` y completá los valores.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Base de datos ---------------------------------------------------------------
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/BASE?schema=public
DATABASE_URL=

# Credenciales que consume docker-compose.yml. Tienen que coincidir con DATABASE_URL.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

# JWT -------------------------------------------------------------------------
# Mínimo 32 caracteres cada uno, y DISTINTOS entre sí (la app no arranca si no).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# App -------------------------------------------------------------------------
PORT=3000
CORS_ORIGIN=http://localhost:3000
