# Variables para los tests e2e. Copiá este archivo a .env.test:
#   cp .env.test.example .env.test
#
# A diferencia de .env.example, acá los valores están completos: no son secretos de
# verdad, son una base descartable que vive en tu máquina.

NODE_ENV="test"

# Apunta al postgres-test de compose.test.yaml (puerto 5434), NO al de desarrollo.
DATABASE_URL="postgresql://test:test@localhost:5434/integrar_test?schema=public"

# Mínimo 32 caracteres cada uno y DISTINTOS entre sí: lo exige src/config/env.validation.ts.
JWT_SECRET="secreto_de_acceso_solo_para_tests_1234567890"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="secreto_de_refresh_solo_para_tests_0987654321"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Las lee compose.test.yaml si algún día lo parametrizás.
POSTGRES_USER="test"
POSTGRES_PASSWORD="test"
POSTGRES_DB="integrar_test"
POSTGRES_PORT=5434